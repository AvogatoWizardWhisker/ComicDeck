<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ComicDeck.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ComicDeck.Core.Models">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Personalization"/>

            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid Padding="0,12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="App theme" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ThemeText, Mode=OneWay}"
                       VerticalAlignment="Center" Opacity="0.8" />
                    </Grid>
                </Expander.Header>

                <StackPanel Spacing="4">
                    <RadioButton x:Name="LightRadio" GroupName="Theme" Content="Light"
                     Tag="Light" Checked="Theme_Checked" />
                    <RadioButton x:Name="DarkRadio" GroupName="Theme" Content="Dark"
                     Tag="Dark" Checked="Theme_Checked" />
                    <RadioButton x:Name="SystemRadio" GroupName="Theme" Content="Use system setting"
                     Tag="Default" Checked="Theme_Checked" />
                </StackPanel>
            </Expander>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Library" Margin="0,12,0,0" />

            <Expander
                IsExpanded="True"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid Padding="0,12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE8B7;" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Library locations" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Click="AddFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add folder" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Expander.Header>

                <StackPanel Spacing="4">
                    <TextBlock Text="No folders added yet." Opacity="0.7"
                               Visibility="{x:Bind ViewModel.HasNoFolders, Mode=OneWay}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LibraryFolder">
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind Path}" ToolTipService.ToolTip="{x:Bind Path}" />
                                    <Button Grid.Column="1" Tag="{x:Bind}" Click="RemoveFolder_Click"
                                            ToolTipService.ToolTip="Remove from library"
                                            AutomationProperties.Name="Remove folder">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <TextBlock Text="Removing a folder takes its comics out of your library, with their reading progress and favorites. Your files are not deleted."
                       Opacity="0.9" TextWrapping="Wrap" />

            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" />
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="About" Margin="0,12,0,0" />

            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid Padding="0,12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE946;" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ComicDeck" />
                            <TextBlock Text="{x:Bind Copyright}" Opacity="0.7"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind VersionText}"
                       VerticalAlignment="Center" Opacity="0.8" />
                    </Grid>
                </Expander.Header>

                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Source code" />
                        <HyperlinkButton Padding="0" Content="github.com/AvogatoWiazrdWhisker/ComicDeck"
                             NavigateUri="https://github.com/AvogatoWizardWhisker/ComicDeck" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Open source libraries" />
                        <HyperlinkButton Padding="0" Content=".NET Community Toolkit (MVVM Toolkit)"
                             NavigateUri="https://github.com/CommunityToolkit/dotnet" />
                        <HyperlinkButton Padding="0" Content="Microsoft.Extensions.DependencyInjection"
                             NavigateUri="https://www.nuget.org/packages/Microsoft.Extensions.DependencyInjection/" />
                        <HyperlinkButton Padding="0" Content="SharpCompress"
                             NavigateUri="https://github.com/adamhathcock/sharpcompress" />
                        <HyperlinkButton Padding="0" Content="sqlite-net"
                             NavigateUri="https://github.com/praeclarum/sqlite-net" />
                        <HyperlinkButton Padding="0" Content="SQLitePCLRaw"
                             NavigateUri="https://github.com/ericsink/SQLitePCL.raw" />
                        <HyperlinkButton Padding="0" Content="Windows App SDK"
                             NavigateUri="https://github.com/microsoft/WindowsAppSDK" />
                        <HyperlinkButton Padding="0" Content="WinUI 3"
                             NavigateUri="https://github.com/microsoft/microsoft-ui-xaml" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
