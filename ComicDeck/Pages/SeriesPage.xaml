<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ComicDeck.Pages.SeriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ComicDeck.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:vm="using:ComicDeck.ViewModels">

    <Grid Padding="24,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Series"/>

        <GridView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="SeriesGrid_ItemClick"
                  ContainerContentChanging="SeriesGrid_ContainerContentChanging">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:SeriesCardViewModel">
                    <StackPanel Width="160" Margin="4" Spacing="6">
                        <Border Width="160" Height="240" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Height="40" MaxLines="2" TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}"/>
                        <TextBlock Height="18" TextTrimming="CharacterEllipsis" Opacity="0.7"
                                   Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Summary}"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
            Visibility="{x:Bind ViewModel.ShowEmptyHint, Mode=OneWay}">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" TextAlignment="Center"
               Text="No series yet" />
            <TextBlock Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
               Text="Comics are grouped by the series name in ComicInfo.xml or in the file name." />
        </StackPanel>
    </Grid>
</Page>
