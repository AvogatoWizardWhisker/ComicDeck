<?xml version="1.0" encoding="utf-8"?>
    <Page
        x:Class="ComicDeck.Pages.LibraryPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ComicDeck.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ComicDeck.ViewModels"
        mc:Ignorable="d"
        KeyboardAcceleratorPlacementMode="Hidden"
        xmlns:controls="using:CommunityToolkit.WinUI.Controls">

        <Page.Resources>
            <CollectionViewSource x:Name="GroupedSource" IsSourceGrouped="True"/>

            <DataTemplate x:Key="ComicCardTemplate" x:DataType="vm:ComicItemViewModel">
                <StackPanel Width="160" Margin="4" Spacing="6"
                            ToolTipService.ToolTip="{x:Bind ToolTipText}">
                    <StackPanel.ContextFlyout>
                        <MenuFlyout>
                        <MenuFlyoutItem Text="{x:Bind FavoriteMenuText, Mode=OneWay}" Tag="{x:Bind}" Click="Favorite_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="{x:Bind FavoriteMenuGlyph, Mode=OneWay}"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Mark as read" Tag="{x:Bind}" Click="MarkRead_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE890;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Mark as unread" Tag="{x:Bind}" Click="MarkUnread_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xED1A;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                    </StackPanel.ContextFlyout>
                    <Border Width="160" Height="240" CornerRadius="4"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid>
                            <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="Uniform"/>
                            <ProgressBar VerticalAlignment="Bottom" Maximum="100"
                                         Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                         Visibility="{x:Bind ShowProgress, Mode=OneWay}"/>
                            <Border Width="24" Height="24" CornerRadius="6" Margin="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                <FontIcon Glyph="&#xE73E;" FontSize="12"/>
                            </Border>
                            <FontIcon Glyph="&#xE735;" FontSize="18" Margin="8"
                                      HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Foreground="Gold"
                                      Visibility="{x:Bind IsFavorite, Mode=OneWay}"/>
                        </Grid>
                    </Border>
                    <TextBlock Height="40" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}"/>
                    <TextBlock Height="18" TextTrimming="CharacterEllipsis" Opacity="0.7"
                               Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Subtitle}"/>
                </StackPanel>
            </DataTemplate>
        </Page.Resources>

        <Grid Padding="24,16,24,0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" 
                           Text="Library" VerticalAlignment="Center" />
                <Button Click="AddFolder_Click"
                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasLibrary, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F4;" FontSize="16" />
                        <TextBlock Text="Add folder" />
                    </StackPanel>
                </Button>
            </StackPanel>

        <controls:WrapPanel Grid.Row="1">
            <controls:WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Margin" Value="0,0,8,8" />
                </Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                    <Setter Property="Margin" Value="0,0,8,8" />
                </Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                    <Setter Property="Margin" Value="0,0,8,8" />
                </Style>
                <Style TargetType="AutoSuggestBox" BasedOn="{StaticResource DefaultAutoSuggestBoxStyle}">
                    <Setter Property="Margin" Value="0,0,8,8" />
                </Style>
            </controls:WrapPanel.Resources>
            
            <AutoSuggestBox x:Name="SearchBox" Width="280" PlaceholderText="Search (Ctrl+F)"
                            QueryIcon="Find" TextChanged="SearchBox_TextChanged"
                            KeyboardAcceleratorPlacementMode="Hidden">
                <AutoSuggestBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch" />
                </AutoSuggestBox.KeyboardAccelerators>
            </AutoSuggestBox>

            <ComboBox x:Name="SortBox" SelectedIndex="0" SelectionChanged="Sort_Changed"
                              AutomationProperties.Name="Sort by" MinWidth="120">
                <ComboBoxItem Tag="Series">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE8F1;" FontSize="18" />
                        <TextBlock Text="Series" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="Title">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE82D;" FontSize="18" />
                        <TextBlock Text="Title" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="RecentlyAdded">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="18" />
                        <TextBlock Text="Recently added" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="RecentlyRead">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE890;" FontSize="18" />
                        <TextBlock Text="Recently read" />
                    </StackPanel>
                </ComboBoxItem>
            </ComboBox>

            <ToggleButton x:Name="ReverseToggle" Click="Reverse_Click"
                  ToolTipService.ToolTip="Reverse order"
                  AutomationProperties.Name="Reverse order">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8CB;" FontSize="18"/>
                    <TextBlock Text="Reverse order"/>
                </StackPanel>
            </ToggleButton>

            <ComboBox x:Name="FilterBox" SelectedIndex="0" SelectionChanged="Filter_Changed"
                          AutomationProperties.Name="Show" MinWidth="120">
                <ComboBoxItem Tag="All">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A9;" FontSize="18" />
                        <TextBlock Text="All comics" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="Unread">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7B3;" FontSize="18" />
                        <TextBlock Text="Unread" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="InProgress">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="18" />
                        <TextBlock Text="In progress" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="Completed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="18" />
                        <TextBlock Text="Completed" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="Favorites">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE734;" FontSize="18" />
                        <TextBlock Text="Favorites" />
                    </StackPanel>
                </ComboBoxItem>
            </ComboBox>

            <Button Click="ShowAlphabet_Click"
            ToolTipService.ToolTip="Jump to a letter"
            Visibility="{x:Bind ViewModel.IsGrouped, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8AD;" FontSize="18"/>
                    <TextBlock Text="Jump to letter"/>
                </StackPanel>
            </Button>

            <Button Click="Rescan_Click" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    ToolTipService.ToolTip="Rescan library folders">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8F7;" FontSize="18" />
                    <TextBlock Text="Rescan" />
                </StackPanel>
            </Button>
        </controls:WrapPanel>


        <StackPanel Grid.Row="2" Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Opacity="0.8" />
                <ProgressBar Maximum="{x:Bind ViewModel.ScanMaximum, Mode=OneWay}"
                             Value="{x:Bind ViewModel.ScanValue, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
            </StackPanel>

            <!-- Series and Title sorts: grouped by letter, with the jump list -->
            <SemanticZoom x:Name="Zoom" Grid.Row="3"
                          Visibility="{x:Bind ViewModel.IsGrouped, Mode=OneWay}"
                          ViewChangeStarted="Zoom_ViewChangeStarted">
                <SemanticZoom.ZoomedInView>
                    <GridView x:Name="GroupedGrid"
                              ItemTemplate="{StaticResource ComicCardTemplate}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="ComicGrid_ItemClick"
                              ContainerContentChanging="ComicGrid_ContainerContentChanging">
                        <GridView.GroupStyle>
                            <GroupStyle HidesIfEmpty="True">
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="vm:ComicGroup">
                                        <TextBlock Margin="4,12,4,4" Text="{x:Bind Key}"
                                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </GridView.GroupStyle>
                    </GridView>
                </SemanticZoom.ZoomedInView>

                <SemanticZoom.ZoomedOutView>
                    <GridView x:Name="AlphaGrid"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Padding="24"
                              ContainerContentChanging="AlphaGrid_ContainerContentChanging">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AlphaTile">
                                <Grid Width="123" Height="30">
                                    <TextBlock Text="{x:Bind Key}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SubtitleTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </SemanticZoom.ZoomedOutView>
            </SemanticZoom>

            <!-- Recently added / read: a plain grid -->
            <GridView x:Name="FlatGrid" Grid.Row="3"
                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      ItemTemplate="{StaticResource ComicCardTemplate}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="ComicGrid_ItemClick"
                      ContainerContentChanging="ComicGrid_ContainerContentChanging"
                      Visibility="{x:Bind ViewModel.IsFlat, Mode=OneWay}" />

            <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                Visibility="{x:Bind ViewModel.ShowEmptyHint, Mode=OneWay}">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" TextAlignment="Center"
                   Text="Your library is empty" />
                <TextBlock Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                   Text="Click “Add folder…” to choose where your comics are." />
                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"
                Margin="0,8,0,0" Click="AddFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F4;" FontSize="16" />
                        <TextBlock Text="Add folder" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"
                       Text="No comics match your search or filter."
                       Visibility="{x:Bind ViewModel.ShowNoMatches, Mode=OneWay}" />
        </Grid>

    </Page>
