<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ComicDeck.Pages.SeriesDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ComicDeck.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ComicDeck.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,0" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <BreadcrumbBar ItemsSource="{x:Bind ViewModel.Crumbs, Mode=OneWay}"
                       ItemClicked="Breadcrumb_ItemClicked">
            <BreadcrumbBar.Resources>
                <x:Double x:Key="BreadcrumbBarChevronFontSize">20</x:Double>
            </BreadcrumbBar.Resources>
            <BreadcrumbBar.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{x:Bind}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                </DataTemplate>
            </BreadcrumbBar.ItemTemplate>
        </BreadcrumbBar>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="160" Height="240" CornerRadius="4"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Image Source="{x:Bind ViewModel.Cover, Mode=OneWay}" Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"
                   Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                <TextBlock Opacity="0.7" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />

                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                   TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis"
                   MaxWidth="720" HorizontalAlignment="Left"
                   Visibility="{x:Bind ViewModel.HasSummary, Mode=OneWay}" />

                <Button Style="{StaticResource AccentButtonStyle}" Margin="0,8,0,0"
                Content="{x:Bind ViewModel.ContinueText, Mode=OneWay}" Click="Continue_Click"
                Visibility="{x:Bind ViewModel.HasContinue, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <GridView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Issues, Mode=OneWay}"
                  SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="Issue_ItemClick"
                  ContainerContentChanging="Issue_ContainerContentChanging">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:ComicItemViewModel">
                    <StackPanel Width="160" Margin="4" Spacing="6"
                                ToolTipService.ToolTip="{x:Bind ToolTipText}">
                        <Border Width="160" Height="240" CornerRadius="4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid>
                                <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="Uniform"/>
                                <ProgressBar VerticalAlignment="Bottom" Maximum="100" Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                         Visibility="{x:Bind ShowProgress, Mode=OneWay}"/>
                                <Border Width="24" Height="24" CornerRadius="12" Margin="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE72E;" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Height="40" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}"/>
                        <TextBlock Height="18" TextTrimming="CharacterEllipsis" Opacity="0.7"
                                   Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Subtitle}"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
