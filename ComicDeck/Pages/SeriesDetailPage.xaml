<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ComicDeck.Pages.SeriesDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ComicDeck.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ComicDeck.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis"
                           Text="{x:Bind ViewModel.Title, Mode=OneWay}"/>
                <TextBlock Opacity="0.7" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"/>
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                    Content="{x:Bind ViewModel.ContinueText, Mode=OneWay}" Click="Continue_Click"
                    Visibility="{x:Bind ViewModel.HasContinue, Mode=OneWay}"/>
        </Grid>

        <GridView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Issues, Mode=OneWay}"
                  SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="Issue_ItemClick"
                  ContainerContentChanging="Issue_ContainerContentChanging">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:ComicItemViewModel">
                    <StackPanel Width="160" Margin="4" Spacing="6"
                                ToolTipService.ToolTip="{x:Bind ToolTipText}">
                        <Border Width="160" Height="240" CornerRadius="4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid>
                                <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="Uniform"/>
                                <ProgressBar VerticalAlignment="Bottom" Maximum="100" Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                         Visibility="{x:Bind ShowProgress, Mode=OneWay}"/>
                                <Border Width="24" Height="24" CornerRadius="12" Margin="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE72E;" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Height="40" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}"/>
                        <TextBlock Height="18" TextTrimming="CharacterEllipsis" Opacity="0.7"
                                   Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Subtitle}"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
