<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ComicDeck.Pages.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="Right" Invoked="OnAccelerator"/>
    <KeyboardAccelerator Key="Left" Invoked="OnAccelerator"/>
    <KeyboardAccelerator Key="Space" Invoked="OnAccelerator"/>
    <KeyboardAccelerator Key="PageDown" Invoked="OnAccelerator"/>
    <KeyboardAccelerator Key="PageUp" Invoked="OnAccelerator"/>
    <KeyboardAccelerator Key="Home" Invoked="OnAccelerator"/>
    <KeyboardAccelerator Key="End" Invoked="OnAccelerator"/>
    <KeyboardAccelerator Key="Escape" Invoked="OnAccelerator"/>
    </Page.KeyboardAccelerators>
    
    <Grid Background="#111111">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" Padding="12,8">
            <Button Click="Back_Click" AutomationProperties.Name="Back">
                <FontIcon Glyph="&#xE72B;"/>
            </Button>
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" VerticalAlignment="Center"/>
        </StackPanel>

        <Image
            x:Name="PageImage"
            Grid.Row="1"
            Stretch="Uniform"
            Source="{x:Bind ViewModel.CurrentImage, Mode=OneWay}"
            SizeChanged="PageImage_SizeChanged"/>

        <ProgressRing
            Grid.Row="1"
            Width="40"
            Height="40"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>

        <TextBlock
            Grid.Row="1"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"/>
    </Grid>
</Page>
